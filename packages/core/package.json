{
  "name": "lucet",
  "version": "0.1.0",
  "description": "Framework-free headless core for Lucet. State logic only: streaming, aborts, tool lifecycle, versioning/restore, scope resolution. Zero framework imports.",
  "license": "MIT",
  "author": "Ian Larson",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/I4NL4RS0N/lucet.git",
    "directory": "packages/core"
  },
  "homepage": "https://lucet.design",
  "bugs": {
    "url": "https://github.com/I4NL4RS0N/lucet/issues"
  },
  "keywords": [
    "ai",
    "chat",
    "ui",
    "components",
    "headless",
    "state-machine",
    "streaming",
    "llm",
    "interface",
    "design-system"
  ]
}
