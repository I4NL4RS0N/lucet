{
  "name": "lucet-react",
  "version": "0.0.1",
  "description": "React bindings for Lucet. A thin wrapper over the lucet core.",
  "license": "MIT",
  "author": "Ian Larson",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucet": "0.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/I4NL4RS0N/lucet.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/I4NL4RS0N/lucet",
  "bugs": {
    "url": "https://github.com/I4NL4RS0N/lucet/issues"
  }
}
