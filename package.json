{
  "name": "lucet-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "AI interface patterns for what comes next.",
  "license": "MIT",
  "author": "Ian Larson",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run build --workspace lucet && npm run build --workspace lucet-react && npm run dev --workspace @lucet/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf packages/*/dist apps/*/dist **/*.tsbuildinfo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:a11y": "npm run build && node scripts/audit-a11y.mjs",
    "verify": "npm run build && npm run typecheck && npm run test && node scripts/audit-a11y.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "playwright": "^1.50.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
